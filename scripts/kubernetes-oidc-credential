#!/usr/bin/env bash
# Kubernetes exec credential plugin. It requests a new GitHub Actions ID token
# for the audience in $1 and prints it as an ExecCredential. The expiry is set
# 30 seconds before the token's exp, so clients request a new token in time.
set -euo pipefail

fail() {
    echo "kubernetes-oidc-credential: $1" >&2
    exit 1
}

audience=${1:-}
[[ -n "$audience" ]] || fail 'usage: kubernetes-oidc-credential AUDIENCE'
[[ -n "${ACTIONS_ID_TOKEN_REQUEST_URL:-}" && -n "${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-}" ]] ||
    fail 'ID token request variables are missing. Grant the job "permissions: id-token: write".'

encoded_audience=$(jq -rn --arg value "$audience" '$value | @uri')
# The request token can mint ID tokens for any audience, so curl reads the
# header from stdin rather than from its command line, which other processes
# can read.
response=$(curl -fsS --retry 3 --retry-all-errors --max-time 30 -H @- \
    "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$encoded_audience" \
    <<<"Authorization: bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN") ||
    fail 'Requesting a GitHub Actions ID token failed.'

jq -L "$(dirname "${BASH_SOURCE[0]}")" -ce 'include "kubernetes-oidc-jwt";
    .value | select(type == "string" and test("^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$")) as $token
    | ($token | jwt_claims | .exp) | select(type == "number") as $exp
    | {apiVersion: "client.authentication.k8s.io/v1", kind: "ExecCredential",
       status: {token: $token, expirationTimestamp: ($exp - 30 | floor | todate)}}
' <<<"$response" 2>/dev/null || fail 'The ID token response has no valid JWT with an exp claim.'
