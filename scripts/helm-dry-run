#!/usr/bin/env bash
# Checks a Helm release against the live cluster without installing it or
# changing live objects:
#
# 1. helm upgrade --install --dry-run=server renders the chart, validates it
#    against the cluster's OpenAPI schema and reads the existing objects. It
#    returns before it sends any object, so it neither runs hooks nor checks
#    admission or write access. It uses the ownership rules of helm-deploy:
#    --take-ownership only in adopt mode (no successful revision yet), so an
#    upgrade that would fail Helm's ownership check also fails here.
# 2. kubectl diff --server-side --force-conflicts --field-manager=helm sends the
#    rendered objects without hooks with dryRun=All. This checks admission and
#    patch access and lists the differences from the live objects. Forcing
#    conflicts shows what a real Helm server-side apply would take over.
set -euo pipefail

# shellcheck source=scripts/helm-common
source "$(dirname "${BASH_SOURCE[0]}")/helm-common"
helm_release_args

# Capture the release privately: --hide-secret would remove Secrets from the
# manifest and skip their admission checks. The release manifest excludes hooks.
# Do not render again: upgrade state, lookups and cluster capabilities must match.
umask 077
directory=$(mktemp -d)
trap 'rm -rf "$directory"' EXIT
rendered="$directory/manifest.yaml"
helm_release_mode "$directory"
ownership=()
if [[ "$mode" == adopt ]]; then
    ownership=(--take-ownership)
fi
# Never remove --dry-run here. helm-deploy installs.
helm upgrade --install "${args[@]}" "${ownership[@]}" --dry-run=server --output json >"$directory/release.json"
jq -je '.manifest | strings' "$directory/release.json" >"$rendered" || fail 'Helm returned no release manifest.'

# kubectl diff exits 1 when it finds differences and above 1 on errors.
status=0
changes=$(kubectl diff --namespace "$NAMESPACE" --server-side --force-conflicts \
    --field-manager=helm --show-secrets=false --filename "$rendered") || status=$?
((status <= 1)) || fail "Server-side dry run failed (kubectl diff exit $status)."
[[ -z "$changes" ]] || echo "$changes"

if ((status == 0)); then changed=false; else changed=true; fi
echo "changed=$changed" >>"$GITHUB_OUTPUT"
{
    echo "**Server dry run of \`$RELEASE\` in \`$NAMESPACE\` passed. No Helm release installed and no live objects changed.**"
    echo
    if [[ "$mode" == adopt ]]; then
        echo "Checked in \`adopt\` mode: the release has no successful revision, so helm-deploy will use \`--take-ownership\`."
    else
        echo "Checked in \`upgrade\` mode: helm-deploy will roll back on failure and will not take over objects that the release did not create."
    fi
    echo
    if [[ "$changed" == false ]]; then
        echo 'The chart matches the live objects.'
    else
        echo '<details><summary>Differences from the live objects</summary>'
        echo
        echo '```diff'
        echo "$changes"
        echo '```'
        echo
        echo '</details>'
    fi
} >>"$GITHUB_STEP_SUMMARY"
