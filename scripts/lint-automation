#!/usr/bin/env bash
set -euo pipefail

command -v actionlint >/dev/null
command -v shellcheck >/dev/null
actionlint

scripts=()
while IFS= read -r -d '' path; do
    [[ -f "$path" ]] || continue
    # Skip vendored dependencies and the rule checkout the semgrep action reserves.
    case "$path" in vendor/*|.semgrep-rules/*) continue ;; esac
    # Match only interpreters ShellCheck supports (sh, bash, dash), not fish or zsh.
    if [[ "$path" == *.sh ]] ||
        head -n 1 "$path" | grep -qE '^#!.*/(env[[:space:]]+)?(ba|da)?sh([[:space:]]|$)'; then
        scripts+=("$path")
    fi
done < <(git ls-files --cached --others --exclude-standard -z)

if ((${#scripts[@]})); then
    options=()
    if [[ -n "${SHELLCHECK_EXCLUDES:-}" ]]; then
        options+=(--exclude="$SHELLCHECK_EXCLUDES")
    fi
    shellcheck "${options[@]}" "${scripts[@]}"
fi
