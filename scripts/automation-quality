#!/usr/bin/env bash
set -euo pipefail

# Tools stay installed for the rest of the job so later steps (for example a
# test suite that ShellChecks snippets) use the same pinned versions.
tools=$(mktemp -d "${RUNNER_TEMP:-/tmp}/automation-tools.XXXXXX")

fetch() {
    # fetch NAME URL SHA256: download into $tools with checksum verification.
    curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 \
        "$2" --output "$tools/$1"
    echo "$3  $tools/$1" | sha256sum --check --quiet
}

fetch actionlint.tar.gz \
    https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_amd64.tar.gz \
    8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
tar --extract --gzip --file "$tools/actionlint.tar.gz" --directory "$tools" actionlint

fetch shellcheck.tar.xz \
    https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.linux.x86_64.tar.xz \
    8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
tar --extract --xz --file "$tools/shellcheck.tar.xz" --strip-components=1 \
    --directory "$tools" shellcheck-v0.11.0/shellcheck

rm -f "$tools"/*.tar.*
export PATH="$tools:$PATH"
if [[ -n "${GITHUB_PATH:-}" ]]; then
    echo "$tools" >>"$GITHUB_PATH"
fi
"$(dirname "$0")/lint-automation"
