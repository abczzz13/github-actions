#!/usr/bin/env bash
set -euo pipefail

fail() {
    echo "$1" >&2
    exit 1
}

# Every input is checked before Git is read.
[[ "${TAG:-}" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] ||
    fail "Tag '${TAG:-}' must be an unprefixed semantic release version, such as 1.2.3."
[[ "${REVIEWED_SHA:-}" =~ ^[0-9a-f]{40}$ ]] || fail "Reviewed commit '${REVIEWED_SHA:-}' is not a full commit SHA."

# refs/tags/ so a branch with the same name cannot stand in for the tag.
sha=$(git rev-parse --verify --quiet "refs/tags/$TAG^{commit}") ||
    fail "Tag '$TAG' does not exist. Check out with fetch-depth: 0 so that tags are present."
git cat-file -e "$REVIEWED_SHA^{commit}" 2>/dev/null ||
    fail "Reviewed commit $REVIEWED_SHA is not in the checkout. Check out with fetch-depth: 0."
git merge-base --is-ancestor "$sha" "$REVIEWED_SHA" ||
    fail "Tag '$TAG' ($sha) is not on the history of reviewed commit $REVIEWED_SHA."

{
    echo "sha=$sha"
    echo "version=$TAG"
} >>"$GITHUB_OUTPUT"
echo "Release $TAG is $sha, on the history of $REVIEWED_SHA."
