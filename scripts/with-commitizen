#!/usr/bin/env bash
set -euo pipefail

script_directory=$(cd -- "$(dirname "$0")" && pwd)
environment=$(mktemp -d "${RUNNER_TEMP:-/tmp}/commitizen.XXXXXX")
trap 'rm -rf "$environment"' EXIT
python -m venv "$environment"
"$environment/bin/python" -m pip install --disable-pip-version-check --quiet \
    -r "$script_directory/commitizen-requirements.txt"
"$environment/bin/python" "$script_directory/commitizen_release.py" "$@"
