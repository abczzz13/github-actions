#!/usr/bin/env bash
# Checks that the joined tailnet identity reaches the Kubernetes API and
# nothing else. Tailscale also lists peers that may reach this runner, such as
# operators' devices, so a visible peer is not necessarily reachable: every
# peer is probed.
set -euo pipefail

fail() {
    echo "$1" >&2
    exit 1
}

ports='^[0-9]{1,5}( [0-9]{1,5})*$'
[[ "${CONTROL_PLANE_TAG:-}" =~ ^tag:[A-Za-z0-9-]+$ ]] ||
    fail "control-plane-tag '${CONTROL_PLANE_TAG:-}' must be a Tailscale tag, such as tag:k8s-controlplane."
[[ "${CONTROL_PLANE_PORT:-}" =~ ^[0-9]{1,5}$ ]] || fail "control-plane-port '${CONTROL_PLANE_PORT:-}' is not a port."
[[ "${CONTROL_PLANE_DENIED_PORTS:-}" =~ $ports ]] ||
    fail 'control-plane-denied-ports must be space-separated ports.'
[[ "${PEER_DENIED_PORTS:-}" =~ $ports ]] || fail 'peer-denied-ports must be space-separated ports.'
read -ra control_plane_denied <<<"$CONTROL_PLANE_DENIED_PORTS"
read -ra peer_denied <<<"$PEER_DENIED_PORTS"
for port in "$CONTROL_PLANE_PORT" "${control_plane_denied[@]}" "${peer_denied[@]}"; do
    ((10#$port >= 1 && 10#$port <= 65535)) || fail "Port '$port' must be between 1 and 65535."
done
# Use decimal ports even when an input has leading zeroes.
CONTROL_PLANE_PORT=$((10#$CONTROL_PLANE_PORT))

tcp_open() {
    # The child Bash expands its positional arguments, not the parent shell.
    # shellcheck disable=SC2016
    timeout 5 bash -c '>/dev/tcp/"$1"/"$2"' bash "$1" "$((10#$2))" 2>/dev/null
}

peers=$(tailscale status --json | jq -c --arg tag "$CONTROL_PLANE_TAG" '
    [(.Peer // {})[] | {name: (.DNSName // ""), ips: (.TailscaleIPs // []),
        kind: (if (.Tags // []) == [$tag] then "controlplane" else "other" end)}]
') || fail 'Reading tailscale status failed.'
jq -e 'any(.[]; .kind == "controlplane" and (.ips | length) > 0)' <<<"$peers" >/dev/null ||
    fail "No $CONTROL_PLANE_TAG peer is visible; the Kubernetes API is unreachable."

# Tailscale drops denied packets, so each closed port waits for the full
# timeout. Run all probes at once and report in peer order afterwards.
results=$(mktemp -d)
trap 'rm -rf "$results"' EXIT

# probe KEY ADDRESS PORT ATTEMPTS creates $results/KEY when the port accepts TCP.
probe() {
    local attempt
    for ((attempt = 1; attempt <= $4; attempt++)); do
        if tcp_open "$2" "$3"; then
            : >"$results/$1"
            return 0
        fi
        ((attempt == $4)) || sleep 2
    done
    return 0
}

max_probes=32
running=0
probe_pids=()
probe_failed=false
start_probe() {
    if ((running >= max_probes)); then
        wait -n || probe_failed=true
        running=$((running - 1))
    fi
    probe "$@" &
    probe_pids+=("$!")
    running=$((running + 1))
}

names=() kinds=() addresses=()
# Read JSON records, not tab-separated fields: Bash read collapses empty fields.
while IFS= read -r peer; do
    names+=("$(jq -r '.name | if . == "" then "unnamed peer" else . end' <<<"$peer")")
    kinds+=("$(jq -r '.kind' <<<"$peer")")
    addresses+=("$(jq -r '.ips | join(" ")' <<<"$peer")")
done < <(jq -c '.[]' <<<"$peers")

denied_ports() {
    if [[ "${kinds[$1]}" == controlplane ]]; then
        echo "${control_plane_denied[*]}"
    else
        echo "${peer_denied[*]}"
    fi
}

for peer in "${!names[@]}"; do
    read -ra ips <<<"${addresses[$peer]}"
    read -ra denied <<<"$(denied_ports "$peer")"
    for address in "${!ips[@]}"; do
        # A control plane needs one working API address. Denied ports must be
        # closed on every IPv4 and IPv6 address, including unused API addresses.
        if [[ "${kinds[$peer]}" == controlplane ]]; then
            start_probe "$peer-$address-api" "${ips[$address]}" "$CONTROL_PLANE_PORT" 3
        fi
        for port in "${denied[@]}"; do
            start_probe "$peer-$address-$((10#$port))" "${ips[$address]}" "$port" 1
        done
    done
done
# Bare wait ignores worker failures. Check every PID, including workers already
# collected by wait -n, before treating missing result files as denied ports.
for pid in "${probe_pids[@]}"; do
    wait "$pid" || probe_failed=true
done
[[ "$probe_failed" == false ]] || fail 'A network probe failed before completing.'

for peer in "${!names[@]}"; do
    name=${names[$peer]}
    read -ra ips <<<"${addresses[$peer]}"
    read -ra denied <<<"$(denied_ports "$peer")"
    if ((${#ips[@]} == 0)); then
        echo "$name: no Tailscale IP, not probed."
        continue
    fi
    open=false
    for address in "${!ips[@]}"; do
        [[ ! -e "$results/$peer-$address-api" ]] || open=true
        for port in "${denied[@]}"; do
            [[ ! -e "$results/$peer-$address-$((10#$port))" ]] ||
                fail "$name (${ips[$address]}) is reachable on TCP $port."
        done
    done
    note=''
    if [[ "${kinds[$peer]}" == controlplane ]]; then
        [[ "$open" == true ]] || fail "Control plane $name (${ips[*]}) is not reachable on TCP $CONTROL_PLANE_PORT."
        note="; $CONTROL_PLANE_PORT reachable"
    fi
    echo "$name: TCP ${denied[*]} denied$note."
done
